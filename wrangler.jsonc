{
	"name": "asakai-touban",
	"main": "./src/worker.js",
	"compatibility_date": "2026-09-16",
	// Basic認証のユーザー名（機密ではないためコード管理）。
	// パスワードはCloudflareダッシュボードのSecretとして別途登録し、ここには置かない。
	"vars": {
		"BASIC_AUTH_USER": "asakai"
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": true
	}
}
